{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "stabilityDays": 28,
  "automerge": true,
  "packageRules": [
    {
      "description": "Major updates do not automerge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "postUpdateOptions": [
    "helmUpdateSubChartDependencies"
  ]
}
